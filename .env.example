# Required for real image generation with --providers gpt
OPENAI_API_KEY=

# Required for Gemini moment extraction, embeddings, labeling, or Gemini image generation
GEMINI_API_KEY=

# Optional model overrides
F_AND_F_GPT_IMAGE_MODEL=gpt-image-2
F_AND_F_MOMENT_MODEL=gemini-3.1-flash-lite-preview
F_AND_F_VISION_MODEL=gemini-2.5-flash
F_AND_F_EMBEDDING_MODEL=gemini-embedding-2

# Optional local path overrides
STRATEGY_CUT_BRAND_DNA_DIR=
STRATEGY_CUT_SOURCE_DIR=
STRATEGY_CUT_PRODUCTS_DIR=
STRATEGY_CUT_RESULTS_DIR=
